{
  "$description": "WIP",

  "ink": { "$type": "color", "$value": "oklch(0.9 0.07 209.09)" },
  "paper": { "$type": "color", "$value": "oklch(0.24 0.03 232.18)" },
  "accent": { "$type": "color", "$value": "oklch(0.9 0.03 264)" },
  "positive-subtle": { "$type": "color", "$value": "oklch(from var(--positive) calc(l - 0.4) c h)" },
  "positive": { "$type": "color", "$value": "{ink}" },
  "positive-strong": { "$type": "color", "$value": "oklch(from var(--positive) calc(l + 0.05) c h)" },
  "negative-subtle": { "$type": "color", "$value": "oklch(from var(--negative) calc(l - 0.52) c h)" },
  "negative": { "$type": "color", "$value": "{accent}" },
  "negative-strong": { "$type": "color", "$value": "oklch(from var(--negative) calc(l + 0.05) c h)" },
  "warning": { "$type": "color", "$value": "color-mix(in oklch, var(--ink), var(--accent) 45%)" },
  "warning-subtle": { "$type": "color", "$value": "oklch(from var(--warning) calc(l - 0.45) c h)" },
  "warning-strong": { "$type": "color", "$value": "oklch(from var(--warning) calc(l + 0.05) c h)" },
  "neutral-subtle": { "$type": "color", "$value": "oklch(from var(--neutral) calc(l - 0.08) c h)" },
  "neutral": { "$type": "color", "$value": "color-mix(in oklch, var(--ink) 45%, var(--paper))" },
  "neutral-strong": { "$type": "color", "$value": "oklch(from var(--neutral) calc(l + 0.15) c h)" },

  "border-w": { "$type": "dimension", "$value": "2px" },
  "border-style": { "$type": "other", "$value": "solid" },

  "shadow": { "$type": "other", "$value": "4px 4px 0 {ink}" },
  "shadow-hover": { "$type": "other", "$value": "2px 2px 0 {ink}" },
  "shadow-active": { "$type": "other", "$value": "0 0 0 {ink}" },

  "hover-shift-x": { "$type": "dimension", "$value": "2px" },
  "hover-shift-y": { "$type": "dimension", "$value": "2px" },

  "radius": { "$type": "dimension", "$value": "0px" },

  "transition-duration": { "$type": "other", "$value": "120ms" },
  "transition-ease": { "$type": "other", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
  "transition": { "$type": "other", "$value": "{transition-duration} {transition-ease}" },

  "font-display": { "$type": "fontFamily", "$value": "\"Michroma\", \"Trebuchet MS\", system-ui, sans-serif" },
  "font-body": { "$type": "fontFamily", "$value": "\"DM Mono\", ui-monospace, \"SF Mono\", Menlo, monospace" },

  "font-weight-normal": { "$type": "fontWeight", "$value": "400" },
  "font-weight-bold": { "$type": "fontWeight", "$value": "700" },

  "font-size-1": { "$type": "dimension", "$value": "clamp(0.875rem, 0.833rem + 0.208vw, 1rem)" },
  "font-size-2": { "$type": "dimension", "$value": "clamp(1rem, 0.958rem + 0.208vw, 1.125rem)" },
  "font-size-3": { "$type": "dimension", "$value": "clamp(1.125rem, 1.042rem + 0.417vw, 1.375rem)" },
  "font-size-4": { "$type": "dimension", "$value": "clamp(1.375rem, 1.25rem + 0.625vw, 1.75rem)" },
  "font-size-5": { "$type": "dimension", "$value": "clamp(1.75rem, 1.583rem + 0.833vw, 2.25rem)" },
  "font-size-6": { "$type": "dimension", "$value": "clamp(2.25rem, 2rem + 1.25vw, 3rem)" },
  "font-size-7": { "$type": "dimension", "$value": "clamp(3rem, 2.667rem + 1.667vw, 4rem)" },

  "font-size-display-1": { "$type": "dimension", "$value": "clamp(0.75rem, 0.688rem + 0.313vw, 0.9375rem)" },
  "font-size-display-2": { "$type": "dimension", "$value": "clamp(0.9375rem, 0.833rem + 0.521vw, 1.25rem)" },
  "font-size-display-3": { "$type": "dimension", "$value": "clamp(1.25rem, 1.125rem + 0.625vw, 1.625rem)" },
  "font-size-display-4": { "$type": "dimension", "$value": "clamp(1.625rem, 1.479rem + 0.729vw, 2.0625rem)" },
  "font-size-display-5": { "$type": "dimension", "$value": "clamp(2.0625rem, 1.854rem + 1.042vw, 2.6875rem)" },
  "font-size-display-6": { "$type": "dimension", "$value": "clamp(2.6875rem, 2.417rem + 1.354vw, 3.5rem)" },
  "font-size-display-7": { "$type": "dimension", "$value": "clamp(3.5rem, 3.167rem + 1.667vw, 4.5rem)" },

  "line-height-tight": { "$type": "other", "$value": "1.05" },
  "line-height-snug": { "$type": "other", "$value": "1.25" },
  "line-height-normal": { "$type": "other", "$value": "1.5" },

  "letter-spacing-tight": { "$type": "dimension", "$value": "-0.01em" },
  "letter-spacing-normal": { "$type": "dimension", "$value": "0em" },
  "letter-spacing-wide": { "$type": "dimension", "$value": "0.05em" },
  "letter-spacing-wider": { "$type": "dimension", "$value": "0.12em" },

  "space-1": { "$type": "dimension", "$value": "0.25rem" },
  "space-2": { "$type": "dimension", "$value": "0.5rem" },
  "space-3": { "$type": "dimension", "$value": "0.75rem" },
  "space-4": { "$type": "dimension", "$value": "1rem" },
  "space-5": { "$type": "dimension", "$value": "1.5rem" },
  "space-6": { "$type": "dimension", "$value": "2rem" },
  "space-7": { "$type": "dimension", "$value": "2.5rem" },
  "space-8": { "$type": "dimension", "$value": "3rem" },
  "space-9": { "$type": "dimension", "$value": "4rem" }
}
